// tongs.roamake.com: a static-assets Worker. `npx wrangler deploy` from this directory uploads
// public/; the first deploy creates the DNS record and certificate for the custom domain.
{
  "name": "tongs-site",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public" },
  "routes": [{ "pattern": "tongs.roamake.com", "custom_domain": true }]
}
